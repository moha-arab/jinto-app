{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "jinto",
    "author": "jinto.gg",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.224.0",
    "description": "Voice AI coach for Valorant.",
    "icon": "icons/IconMouseOver.png",
    "icon_gray": "icons/IconMouseNormal.png",
    "launcher_icon": "icons/desktop-icon.ico",
    "window_icon": "icons/IconMouseOver.png",
    "dock_button_title": "jinto"
  },
  "permissions": ["Hotkeys", "GameInfo", "Microphone"],
  "data": {
    "start_window": "background",
    "hotkeys": {
      "jinto_ptt": {
        "title": "Push to talk to jinto",
        "action-type": "custom",
        "hold": true,
        "default": "Oemtilde"
      },
      "jinto_toggle_settings": {
        "title": "Show/hide jinto dashboard",
        "action-type": "toggle",
        "default": "Alt+F"
      }
    },
    "externally_connectable": {
      "matches": [
        "https://api.openai.com",
        "https://fonts.googleapis.com",
        "https://fonts.gstatic.com",
        "https://api.deepgram.com",
        "wss://api.deepgram.com",
        "https://api.anthropic.com",
        "https://api.cartesia.ai",
        "wss://api.cartesia.ai"
      ]
    },
    "windows": {
      "background": {
        "file": "windows/background/background.html",
        "is_background_page": true,
        "background_optimization": false
      },
      "overlay": {
        "file": "windows/overlay/overlay.html",
        "in_game_only": true,
        "transparent": true,
        "clickthrough": true,
        "topmost": true,
        "show_in_taskbar": false,
        "resizable": false,
        "size": { "width": 1920, "height": 1080 },
        "start_position": { "top": 0, "left": 0 }
      },
      "desktop": {
        "file": "windows/desktop/desktop.html",
        "resizable": true,
        "transparent": false,
        "topmost": true,
        "grab_keyboard_focus": true,
        "focus_game_takeover": "ReleaseOnLostFocus",
        "size": { "width": 760, "height": 620 }
      }
    },
    "game_targeting": { "type": "dedicated", "game_ids": [21640] },
    "game_events": [21640],
    "launch_events": [
      { "event": "GameLaunch", "event_data": { "game_ids": [21640] }, "start_minimized": true }
    ],
    "developer": {
      "enable_auto_refresh": true,
      "reload_delay": 1000,
      "filter": "*.*"
    }
  }
}
